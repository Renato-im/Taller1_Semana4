@model IEnumerable<AvengersBovedaMvc.Models.Artefacto>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.poseedor)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.energia)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.poseedor)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.energia)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.artefactoID }) |
            @Html.ActionLink("Details", "Details", new { id=item.artefactoID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.artefactoID })
        </td>
    </tr>
}

</table>
